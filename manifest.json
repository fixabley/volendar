{
  "manifest_version": 3,
  "name": "Volendar - 봉사 달력",
  "version": "0.1.1",
  "description": "1365·VMS에서 신청한 봉사와 모집 중인 봉사를 한 달력에서 보고 ICS로 내보냅니다.",
  "homepage_url": "https://github.com/fixabley/volendar",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "봉사 달력 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.1365.go.kr/*",
    "https://www.vms.or.kr/*"
  ],
  "optional_host_permissions": [
    "https://calendar.google.com/*",
    "https://*.icloud.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.office.com/*"
  ]
}
